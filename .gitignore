# macOS
.DS_Store

# SwiftPM's build products, and Xcode's per-user state when it opens Package.swift
/.build/
/.swiftpm/

# Intermediate, rebuilt by icon/make_icon.py
icon/AppIcon.iconset/

# Left on this machine by the Python app this one replaced: its environment, its PyInstaller
# output, the folder its downloads used to land in (which may still hold files) and its leftover
# database. Ignored rather than deleted: they are on disk here, not in the repository.
.venv/
__pycache__/
/build/
/dist/
/videos/
panel.db*
