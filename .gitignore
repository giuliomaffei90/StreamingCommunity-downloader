# Python
*__pycache__
.pytest_cache/
.venv/
venv/

# Downloads. Not a configured path — that lives outside the repo now — but the
# folder from before it moved, which still holds files.
videos/

# macOS
.DS_Store

# Runtime state, written by the app into ~/Library/Application Support.
# Kept here because DATA_FILE and friends can still be pointed at the repo by
# an environment variable, and data.json carries the source domain.
data.json
data.json.lock

# Build artifacts (PyInstaller). Anchored to the repo root: a bare "build/"
# matches a directory of that name at any depth, and swallowed
# .claude/skills/build/ whole.
/build/
/dist/

# Intermediate, rebuilt by icon/make_icon.py
icon/AppIcon.iconset/
